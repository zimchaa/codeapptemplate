# Committed defaults. Override per machine in .env.local (git-ignored), or set
# VITE_DATA_MODE in the shell; shell variables win over these files.
#
#   mock      - in-memory data, runs fully offline (default for `pnpm dev`)
#   powerapps - @microsoft/power-apps client; needs the Local Play URL or a
#               published app
VITE_DATA_MODE=mock
