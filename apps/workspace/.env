# Committed defaults. Override per machine in .env.local (git-ignored).
#
# VITE_DATA_MODE
#   mock      - sample data in the browser, fully offline (default for `pnpm dev`)
#   powerapps - Dataverse through @microsoft/power-apps; needs Local Play or a published app
VITE_DATA_MODE=mock

# Dataverse publisher prefix of the workspace tables (spg_request, ...).
# Must match the prefix used with `pnpm dataverse:provision --prefix`.
VITE_DATAVERSE_PREFIX=spg
