{
  "name": "@codeapps/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace UI kit: Tailwind 3 preset, theme tokens (foundation-red, neutral) and React components. Swap point for an internal component library.",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./tailwind-preset": "./tailwind-preset.js",
    "./themes.css": "./src/theme/themes.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.56.0",
    "tailwind-merge": "2.6.1"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
